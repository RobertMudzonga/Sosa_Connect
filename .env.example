# Copy to .env and fill in. .env is git-ignored.

# Backend URL. On a phone, use your computer's LAN IP, e.g. http://192.168.1.20:3000/api/v1
API_URL=http://localhost:3000/api/v1

# Optional override; the default is the @robert263/kuwana project in app.json
# EAS_PROJECT_ID=

# Maps need no key: they use MapLibre with free OpenFreeMap tiles (components/map-config.ts).
